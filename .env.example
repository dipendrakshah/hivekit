# Hivekit environment — copy to .env (compose reads it automatically).
# Never commit the real file. Two secrets, different jobs (deploy/README.md):

# Bootstrap owner token: authenticates first-login passkey setup and loss recovery.
HIVEKIT_TOKEN=

# Vault key: AES-256-GCM master key for every stored credential.
# Lose it -> re-enter credentials. Leak it -> volume holder reads them all.
HIVEKIT_MASTER_KEY=

# Public hostname / URL used for session-cookie Secure flags and doctor's TLS check.
PUBLIC_URL=http://localhost:8787
HIVE_HOST=hive.example.com

TZ=Asia/Kolkata